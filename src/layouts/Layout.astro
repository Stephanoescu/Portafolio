---
import '../styles/global.css';
import Navbar from '../components/Navbar';

interface Props {
  title?: string;
}

const { title = 'Stephano Espinoza Cueva - Software Engineer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0c0c0d" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="Portafolio de Stephano Espinoza Cueva - Ingeniero de Software, Frontend y Full Stack Developer en Lima, Perú, enfocado en experiencias web de alto rendimiento." />
  <meta name="keywords" content="Software Engineer, Frontend Developer, Full Stack, React, Angular, Vue, Astro, Lima, Perú" />
  <meta name="author" content="Stephano Espinoza Cueva" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Ingeniero de Software obsesionado con la optimización y el rendimiento." />
  <meta property="og:type" content="website" />

  <!-- Tipografía -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <title>{title}</title>
</head>
<body>
  <Navbar client:load />
  <main>
    <slot />
  </main>
</body>
</html>
